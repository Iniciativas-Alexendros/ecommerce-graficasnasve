# graficasnasve.art — Variables de entorno
# Copiar a .env.local y rellenar valores reales. NUNCA subir .env.local a git.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://XXXXXXXXXXXXXXXX.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=no-reply@graficasnasve.art
RESEND_PRESUPUESTO_TO=alicia@nasve.com

# Stripe (el cliente configura estos valores)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App
NEXT_PUBLIC_APP_URL=https://graficasnasve.art

# ─── INSTRUCCIONES SUPABASE ────────────────────────────────────────────────────
# 1. Crear proyecto en Supabase (región eu-west-1 — Irlanda)
# 2. En SQL Editor ejecutar el schema de ARCHITECTURE.md:
#    - CREATE TABLE presupuestos (...)
#    - CREATE TABLE pedidos (...)
#    - CREATE TABLE portfolio (...)
#    - Bucket 'arte-files' (privado)
#    - RLS policies
# 3. Para generar tipos TypeScript:
#    pnpm supabase gen types typescript --project-id XXXXXXXXXXXXXXXX > src/types/supabase.ts
